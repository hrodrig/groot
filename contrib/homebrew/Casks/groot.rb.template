# Casks/groot.rb.template
# =========================
# Source-of-truth cask file for the `groot` CLI.
#
# This file lives in the upstream `groot` repo at
# `contrib/homebrew/Casks/groot.rb.template` and is the **seed** for the
# `hrodrig/homebrew-groot` tap repository. The bootstrap procedure is:
#
#   1. Create the public repo `hrodrig/homebrew-groot`.
#   2. Copy this file into the tap repo at `Casks/groot.rb`.
#   3. Commit: `chore: bootstrap from hrodrig/groot contrib/homebrew`.
#   4. From that point on, GoReleaser owns the tap through the
#      `brews:` stanza in `.goreleaser.yaml` of the upstream repo.
#
# Placeholders used by GoReleaser (in the upstream `brews:` block):
#
#   {{ .Tag }}          - full git tag, e.g. "v0.6.0"
#   {{ .Version }}      - bare version, e.g. "0.6.0"
#   {{ .SHA256 }}       - SHA256 of the corresponding release tarball
#   {{ .Arm64MacOSURL }} - arm64 darwin tarball URL (when goos=darwin, goarch=arm64)
#   {{ .MacOSURL }}     - amd64 darwin tarball URL
#   {{ .LinuxAMD64URL }}- amd64 linux tarball URL
#   {{ .LinuxARM64URL }}- arm64 linux tarball URL
#
# A `groot.rb` already rendered for a real release looks like the
# comment below — the `version`, `sha256`, and per-arch `url` blocks are
# what GoReleaser substitutes on every tag push.
#
# Example rendered cask (v0.6.0, do not edit by hand):
#
#   cask "groot" do
#     version "0.6.0"
#     sha256 arm64_darwin:  "a1b2c3…",
#            intel:        "d4e5f6…",
#            arm64_linux:   "g7h8i9…",
#            x86_64_linux:  "j0k1l2…"
#
#     url "https://github.com/hrodrig/groot/releases/download/v0.6.0/groot_v0.6.0_{{arch}}.tar.gz"
#     name "groot"
#     desc "Read-only log and context collector for Kubernetes"
#     homepage "https://github.com/hrodrig/groot"
#
#     livecheck do
#       url :stable
#       strategy :github_latest_release
#     end
#
#     binary "groot"
#
#     zap trash: "~/.config/groot"
#
#     caveats <<~EOS
#       A sample configuration is included at
#         /usr/local/etc/groot/groot.yml.sample (nfpms install)
#         /opt/homebrew/etc/groot/groot.yml.sample (Homebrew nfpms install)
#       Copy it and edit in place:
#         sudo cp /usr/local/etc/groot/groot.yml.sample /usr/local/etc/groot/groot.yml
#         sudo chown $USER /usr/local/etc/groot/groot.yml
#     EOS
#   end
#
# The `url` line above uses the bash-style `{{arch}}` placeholder from
# Homebrew's URL resolution; GoReleaser writes per-arch `url` blocks
# in the rendered cask to keep things explicit. The template above is
# the **starting point** — GoReleaser will overwrite it on each release.

cask "groot" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/hrodrig/groot/releases/download/v#{version}/groot_v#{version}_{{arch}}.tar.gz"
  name "groot"
  desc "Read-only log and context collector for Kubernetes"
  homepage "https://github.com/hrodrig/groot"

  livecheck do
    url :stable
    strategy :github_latest_release
  end

  binary "groot"

  zap trash: "~/.config/groot"

  caveats <<~EOS
    Sample configuration is not bundled with the Homebrew cask.
    To install it:
      brew tap hrodrig/groot
      brew install groot --with-config
    (or copy contrib from the upstream repo into ~/.config/groot/groot.yml).
  EOS
end
