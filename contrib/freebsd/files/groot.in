#!/bin/sh
#
# $FreeBSD$
#
# PROVIDE: groot
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# `service groot onestart` / `service groot onestop` are no-ops in this
# version. GROOT runs as a one-shot CLI (`groot collect`) and does not
# yet have a long-running watch mode (planned for 0.7.x). The rc.d
# script is provided so operators can `sysrc groot_enable=YES` ahead of
# watch-mode landing, and so cron(8) jobs calling `service groot` get
# exit-0 today.
#
# Add to /etc/rc.conf:
#   groot_enable="YES"
#   groot_config="/usr/local/etc/groot/groot.yml"
#   grot_output_dir="/var/log/groot"
#
# Then in periodic(8) or a one-off shell:
#   service groot onestart
#
# This is intentionally minimal; see 0.7.x roadmap for the watch mode
# that will turn this into a proper daemon.

. /etc/rc.subr

name=groot
rcvar=${name}_enable

load_rc_config "${name}"

: "${groot_enable:=\"NO\"}"
: "${groot_config:=\"/usr/local/etc/groot/groot.yml\"}"
: "${grot_output_dir:=\"/var/log/groot\"}"

command=/usr/local/bin/groot
command_args="collect --config ${groot_config}"
start_cmd="${name}_onestart"
stop_cmd=":"

groot_onestart()
{
    echo "groot: running one-shot collect (no daemon; this is a no-op stub)."
    echo "groot: configure ${groot_config} and use cron(8) or periodic(8) for scheduling."
    # Intentionally do not invoke ${command} here. Operators should set up
    # a cron job for scheduled collects; the rc.d hook is a placeholder.
    return 0
}

run_rc_command "$1"
