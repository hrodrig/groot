# Deny-all by default (whitelist only what ships in this repo)
*
.*

# Repository metadata & root config
!.gitignore
!.dockerignore
!.goreleaser.yaml
!.github/
!.github/**

!Dockerfile
!Dockerfile.release
!Makefile
!GNUmakefile
!README.md
!VERSION
!LICENSE
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md
!AGENTS.md
!ROADMAP.md
!SPECIFICATIONS.md
!codecov.yml
!docker-compose.yml
!go.mod
!go.sum
!configs/
!configs/**
!examples/
!examples/**

!testing/
!testing/**

!scripts/
!scripts/**

!contrib/
!contrib/**

# Generated by GoReleaser before hooks (do not commit).
contrib/man/man1/*.1.gz

# Source and documentation
!cmd/
!cmd/**
!internal/
!internal/**
internal/cmd/out/
!docs/
!docs/**
!.planning/
!.planning/**

# Local GSD/research noise (re-ignore after .planning whitelist)
.planning/research/.cache/
.planning/**/.??-*-start-epoch
.planning/**/.??-*-start-time

# Build output dir: keep directory in git with a placeholder only (see Makefile → bin/)
!bin/
!bin/.keep

# GoReleaser + BSD port build output (gitignored at the deny-all level above
# because we use the `*` glob; no whitelist needed).
dist/

# Local / OS noise (redundant with *; keeps intent visible)
.DS_Store
